# -----------------------------------------------------------------------------
# Notrole - modelo de configuracao
#
# Copie este arquivo para ".env" e preencha os valores. O ".env" NAO vai para o
# controle de versao: ele guarda segredos.
#
# A API confere estas variaveis na inicializacao (src/api/config/env.ts). Se
# faltar alguma obrigatoria, o processo encerra dizendo qual e - em vez de
# subir e falhar na primeira requisicao.
# -----------------------------------------------------------------------------

# --- Servidor ----------------------------------------------------------------
NODE_ENV=production
PORT=3333
# A API so atende o IIS da propria maquina. Nao troque por 0.0.0.0.
HOST=127.0.0.1
# Endereco publico do sistema (o IIS faz proxy reverso desta porta).
APP_URL=https://notrole.exemplo.com.br

# Origens liberadas no CORS, separadas por virgula.
# Em producao o proprio Express serve o frontend, entao pode ficar vazio.
# Em desenvolvimento, use: http://localhost:3000
CORS_ORIGINS=

# --- Banco de dados ----------------------------------------------------------
DATABASE_URL="postgresql://usuario:senha@host:5432/notrole_db?schema=public"

# --- Microsoft Entra ID ------------------------------------------------------
# Identificadores do app registration (Azure Portal > Entra ID > Registros de
# aplicativo). Nao sao segredos, mas ficam aqui para nao voltarem ao codigo.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# Segredo do cliente, usado pela API para consultar o Microsoft Graph
# (permissoes de aplicativo User.Read.All e GroupMember.Read.All).
# Lembre-se de anotar a data de expiracao: quando ele vence, a busca de
# colaboradores no AD para de funcionar.
AZURE_CLIENT_SECRET=

# Object ID do grupo de seguranca cujos membros podem usar o sistema
# (Entra ID > Grupos > o grupo > Object ID).
# Se ficar vazio, QUALQUER conta do tenant tem acesso total.
AZURE_GRUPO_AUTORIZADO_ID=

# Grupo de administradores do Notrole (opcional). Quem esta nele movimenta o
# estoque de todas as empresas e cadastra categorias; os demais analistas veem e
# movimentam so a empresa do AD deles. Vazio: todos sao administradores.
AZURE_GRUPO_ADMIN_ID=

# --- Servidor de e-mail (SMTP) -----------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Notrole
# true apenas para a porta 465 (TLS implicito).
SMTP_SECURE=false
# Deixe true. Use false SO se o seu servidor SMTP interno tiver certificado
# autoassinado (a conexao continua cifrada, mas sem validar o certificado).
SMTP_REJECT_UNAUTHORIZED=true

# Quem recebe os alertas de operacao (API caiu, banco fora, backup falhou...),
# enviados pelo watchdog. Varios separados por virgula.
ALERTA_EMAIL=ti@exemplo.com.br

# --- D4Sign (termo de responsabilidade) --------------------------------------
# Deixe tudo vazio para desligar a integracao. Sem ela, os emprestimos sao
# criados ja como ATIVO, sem termo para assinar.
# Chave geral: false = nenhuma chamada ao D4Sign, emprestimos sem termo.
# Ligue (true) so depois de conferir o contrato com scripts/d4sign-teste-contrato.ts.
D4SIGN_ATIVO=false
D4SIGN_API_KEY=
D4SIGN_CRYPT_KEY=
D4SIGN_SAFE_ID=
# Modelo Word do termo de EMPRESTIMO, preenchido pelo proprio Notrole. Vazio =
# docs/modelos/termo-comodato-emprestimo.docx (a entrega usa sempre
# docs/modelos/termo-comodato-entrega.docx).
D4SIGN_MODELO=

# Cuidado com custo: o uso do D4Sign e cobrado por documento enviado.
# producao | sandbox (ambiente de testes do D4Sign, sem cobranca)
D4SIGN_AMBIENTE=producao
# Teto do NOTROLE, abaixo do limite da conta (10), para nao esgotar a cota de
# outras integracoes que usem a mesma conta.
D4SIGN_REQUISICOES_POR_HORA=6
D4SIGN_MAX_TENTATIVAS=3
# Conferencia automatica da assinatura (horario comercial, espacada).
D4SIGN_CONSULTA_AUTOMATICA=true
D4SIGN_HORAS_ENTRE_CONSULTAS=4
D4SIGN_DIAS_MAX_CONSULTA=15
# Segredo que o D4Sign deve mandar no cabecalho x-notrole-secret ao chamar
# POST /api/webhooks/d4sign. Sem ele, o webhook fica desligado.
D4SIGN_WEBHOOK_SECRET=

# --- Rotinas automaticas -----------------------------------------------------
CRON_TIMEZONE=America/Sao_Paulo
# De hora em hora, das 8h as 18h, de segunda a sexta. Por emprestimo, sai no
# maximo uma cobranca por dia e um lembrete por prazo, entao rodar varias vezes e seguro e
# permite que o sistema se recupere de um disparo perdido.
CRON_COBRANCA=0 8-18 * * 1-5
CRON_LEMBRETE=30 8-18 * * 1-5
# A fila de termos roda de 5 em 5 minutos, todos os dias: um termo que ficou
# esperando cota precisa sair assim que ela liberar, nao so no dia seguinte.
CRON_TERMOS=*/5 * * * *
JOBS_HABILITADOS=true

# -----------------------------------------------------------------------------
# Frontend (lidas pelo Vite no momento do BUILD, nao em tempo de execucao).
# Depois de mudar qualquer VITE_*, e preciso rodar "npm run build" de novo.
# -----------------------------------------------------------------------------

# Vazio = usa /api na mesma origem, que e o correto em producao.
VITE_API_URL=
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=

# Scope exposto pela propria API no Entra ID
# (Expor uma API > Adicionar um escopo), no formato:
#   api://00000000-0000-0000-0000-000000000000/access_as_user
# Com ele, o frontend manda o access token correto. Vazio = continua mandando
# o id token, como na versao anterior.
VITE_AZURE_API_SCOPE=
